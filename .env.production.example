# ===== ADUKANAJA — contoh pengaturan PRODUKSI =====
# Salin menjadi .env di server, lalu isi nilai yang bertanda <...>. JANGAN commit file .env.

APP_NAME=ADUKANAJA
APP_ENV=production
APP_KEY=                      # isi dengan: php artisan key:generate
APP_DEBUG=false               # WAJIB false di server sungguhan
APP_URL=https://<domain-anda>

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<nama_database>
DB_USERNAME=<user_database>   # JANGAN memakai root
DB_PASSWORD=<password_kuat>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true    # cookie sesi hanya lewat HTTPS
CACHE_STORE=database
QUEUE_CONNECTION=database
